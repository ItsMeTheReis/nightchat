# NightChat — configuração por ambiente. Copie para .env e ajuste.
# NUNCA versione o .env real. Secrets ficam FORA do código.

# --- Cliente ---
# Sem NENHUMA das variáveis abaixo definidas, o cliente usa o relay
# OFICIAL da release (https://relay.nightchat.dev, wss:// para o
# WebSocket) — nunca localhost. Esse domínio é o padrão de PRODUÇÃO já
# codificado no cliente; ele só fica realmente no ar depois que a infra
# em docs/DEPLOYMENT.md for provisionada (VPS + DNS + TLS). Até lá, uma
# instalação sem override mostra um erro claro ("Unable to connect to
# NightChat Relay") em vez de travar silenciosamente.
#
# Para desenvolvimento local (relay rodando na sua própria máquina),
# defina explicitamente:
# NIGHTCHAT_RELAY_URL=http://localhost:8000

# Forma avançada: define HTTP e WS separadamente (tem prioridade sobre
# NIGHTCHAT_RELAY_URL se definidos — útil atrás de um proxy que separa
# os dois hosts). Use https:// / wss:// em produção; http:// / ws:// só
# em dev local. O token de sessão NÃO vai na URL do WebSocket — o
# cliente autentica mandando {"type":"auth","token":"..."} como primeira
# mensagem depois de conectar.
# NIGHTCHAT_RELAY_HTTP=http://localhost:8000
# NIGHTCHAT_RELAY_WS=ws://localhost:8000/ws

# Conveniência OPCIONAL de dev/teste: só sugere um valor no prompt de
# username (Enter aceita a sugestão); NUNCA é definida pelo instalador e
# NUNCA vira um "usuário padrão de fábrica". Uma instalação real sempre
# passa pelo onboarding e exige um username digitado pelo usuário.
# NIGHTCHAT_USERNAME=devtester

# --- Servidor: ambiente e TLS ---
# "development" (padrão) ou "production". Em produção, o servidor SE
# RECUSA A SUBIR (RuntimeError) se JWT_SECRET for fraco/padrão, se
# NIGHTCHAT_REQUIRE_TLS não for true, ou se DATABASE_URL for sqlite.
NIGHTCHAT_ENV=development

# Quando true, o relay exige que toda requisição HTTP e todo handshake de
# WebSocket chegue como https/wss — direto (TLS termina no uvicorn com
# certificado) ou via header X-Forwarded-Proto de um proxy reverso
# confiável na frente. Deixe false só em desenvolvimento local.
NIGHTCHAT_REQUIRE_TLS=false

NIGHTCHAT_HOST=0.0.0.0
NIGHTCHAT_PORT=8000
NIGHTCHAT_LOG_LEVEL=INFO

# --- Servidor: banco de dados ---
# Produção: PostgreSQL. Dev/testes: sqlite:/// funciona sem instalar nada
# (e é o que a suíte de testes usa por padrão — ver tests/conftest.py).
# Testar contra Postgres de verdade: ver tests/test_postgres_integration.py
# (variável separada NIGHTCHAT_TEST_POSTGRES_URL, só para a suíte de testes).
DATABASE_URL=postgresql+psycopg://nightchat:nightchat@localhost:5432/nightchat

# Pool de conexões (só tem efeito com Postgres; SQLite ignora). Existe
# para que muitos usuários com WebSocket aberto NÃO consigam esgotar o
# pool e travar login/registro de todo mundo — o WebSocket, hoje, só usa
# uma conexão do pool de forma pontual e breve durante o handshake.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

# --- Servidor: JWT ---
# Em produção, exigido ter pelo menos 32 caracteres e não ser o valor de
# desenvolvimento abaixo — senão o servidor recusa subir com NIGHTCHAT_ENV=production.
JWT_SECRET=troque-por-um-segredo-forte-gerado-aleatoriamente
JWT_TTL_SECONDS=900

# --- Servidor: Argon2id ---
# Ajuste ao hardware do servidor.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# --- Servidor: rate limiting (janela fixa, em memória — server/ratelimit.py) ---
# Cada par MAX/WINDOW define "no máximo MAX eventos a cada WINDOW segundos"
# por chave (IP para endpoints REST não-autenticados; username para
# operações de WebSocket já autenticadas). Excedeu: REST responde 429,
# WebSocket responde {"type":"error","reason":"rate_limited"}.
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60

RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

RATE_LIMIT_EXISTS_MAX=20
RATE_LIMIT_EXISTS_WINDOW_SECONDS=60

RATE_LIMIT_CONNECT_REQUEST_MAX=10
RATE_LIMIT_CONNECT_REQUEST_WINDOW_SECONDS=60

RATE_LIMIT_WS_MESSAGE_MAX=30
RATE_LIMIT_WS_MESSAGE_WINDOW_SECONDS=10
